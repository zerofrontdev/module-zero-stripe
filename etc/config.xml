    Capture-only method (no initialize()): the payment is confirmed client-side
    before the order is placed; Model\Standard::capture() verifies it.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:App/etc/config.xsd">
    <default>
        <payment>
            <zero_stripe>
                <active>0</active>
                <model>Zero\Stripe\Model\Standard</model>
                <order_status>processing</order_status>
                <payment_action>authorize_capture</payment_action>
                <title>Credit Card (Stripe)</title>
                <allowspecific>0</allowspecific>
                <group>offline</group>
            </zero_stripe>
            <!-- Stripe Checkout: payment_action "order", so Payment::place() calls initialize() (the Checkout Session). -->
            <zero_stripe_checkout>
                <active>0</active>
                <model>Zero\Stripe\Model\Checkout\Payment</model>
                <title>Pay Later, Wallets and More (Stripe)</title>
                <hold>0</hold>
                <webhook_secret backend_model="Magento\Config\Model\Config\Backend\Encrypted"/>
                <order_status>pending_payment</order_status>
                <payment_action>order</payment_action>
                <allowspecific>0</allowspecific>
                <sort_order>27</sort_order>
                <group>offline</group>
            </zero_stripe_checkout>
        </payment>
    </default>
</config>
