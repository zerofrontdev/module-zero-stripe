<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Placing a Stripe card order failed after the card was authorized: release the hold. -->
    <event name="zero_checkout_place_order_failed">
        <observer name="zero_stripe_release_failed_placement" instance="Zero\Stripe\Observer\ReleaseFailedPlacement"/>
    </event>
    <event name="sales_model_service_quote_submit_failure">
        <observer name="zero_stripe_release_failed_placement" instance="Zero\Stripe\Observer\ReleaseFailedPlacement"/>
    </event>
</config>
