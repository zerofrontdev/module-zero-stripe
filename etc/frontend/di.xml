<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Zero\Checkout\Model\SupportedPaymentMethods">
        <arguments>
            <argument name="methods" xsi:type="array">
                <item name="zero_stripe_checkout" xsi:type="string" translate="true">Pay later with Afterpay, Affirm or Klarna, or pay with Cash App, a wallet or a card on Stripe's secure page after placing the order.</item>
            </argument>
        </arguments>
    </type>
    <!-- The card was only authorized in the browser: capture it once the order is saved (an invoice, Capture Online). -->
    <type name="Zero\Checkout\Controller\Checkout\Placeorder">
        <arguments>
            <argument name="afterPlaceOrder" xsi:type="array">
                <item name="stripe_capture" xsi:type="object">Zero\Stripe\Model\CaptureAfterPlace</item>
            </argument>
        </arguments>
    </type>
</config>
